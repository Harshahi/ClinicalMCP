MCP_PAT=replace-with-your-pat
MCP_ACCESS_URL=https://clinicalmcp.example.com/mcp
MCP_PUBLIC_URL=https://clinicalmcp.example.com
MCP_HOST=0.0.0.0
MCP_PORT=8000
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=demo

# Comma-separated list of browser origins allowed to call this server.
# Leave empty to refuse every request that carries an Origin header, which is
# the safe default for a server only used by non-browser MCP clients.
MCP_ALLOWED_ORIGINS=

# Local development only. When MCP_PAT is empty the server refuses to start;
# set this to true to deliberately run without authentication.
# MCP_ALLOW_UNAUTHENTICATED=true
